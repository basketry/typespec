{
  "compilerOptions": {
    "lib": ["es2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "noImplicitReturns": true,
    "outDir": "lib",
    "sourceMap": true,
    "target": "es2022",
    "declaration": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.*.ts"]
}
