{
  "name": "@basketry/typespec",
  "version": "0.1.0",
  "description": "Basketry parser for TypeSpec service definitions",
  "type": "module",
  "main": "./lib/index.cjs",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "bin": {
    "basketry-typespec": "./lib/rpc.js"
  },
  "scripts": {
    "test": "vitest run",
    "clean": "run-s -s clean:*",
    "create-snapshot": "ts-node ./src/snapshot/create-snapshot.ts",
    "lint": "run-s -s lint:*",
    "fix": "run-s -s fix:*",
    "clean:output": "rimraf lib",
    "clean:coverage": "rimraf coverage",
    "start": "node ./lib/index.js",
    "prebuild": "run-s -s clean lint",
    "build": "tsc",
    "postbuild": "chmod +x ./lib/rpc.js && cp ./src/index.cjs ./lib/index.cjs",
    "lint:eslint": "eslint .",
    "fix:eslint": "eslint --fix",
    "lint:prettier": "prettier -c .",
    "fix:prettier": "prettier -w .",
    "pretest": "run-s -s clean",
    "prepack": "run-s -s build"
  },
  "keywords": [],
  "author": "Steve Konves",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basketry/typespec.git"
  },
  "bugs": {
    "url": "https://github.com/basketry/typespec/issues"
  },
  "homepage": "https://basketry.io/docs/components/@basketry/typespec",
  "funding": "https://github.com/sponsors/basketry",
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "rimraf": "^3.0.2",
    "ts-node": "^10.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@typespec/compiler": "^1.0.0",
    "@typespec/http": "^1.0.0",
    "@typespec/rest": "^0.80.0",
    "basketry": "^0.2.1"
  }
}
