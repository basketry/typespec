{
  "preset": "ts-jest/presets/default-esm",
  "testEnvironment": "node",
  "collectCoverage": true,
  "passWithNoTests": true,
  "testMatch": [
    "**/__tests__/**/*.ts?(x)",
    "**/?(*.)+(spec|test|tests).ts?(x)"
  ],
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
